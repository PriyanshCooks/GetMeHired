# =====================================================================
# GetMeHired — Environment Configuration (.env.example)
# Copy this file to .env and customize it for your background & search.
# =====================================================================

# Server Configuration
PORT=8000
HOST=127.0.0.1

# Local Ollama LLM Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
LLM_TEMPERATURE=0.4

# Stage Banner Configuration (Configures dashboard empty state & hero banners)
STAGE_BANNER_TITLE="Stage Ready for {name} ({salary} AI Opportunities)"
STAGE_BANNER_DESCRIPTION="Your profile, skills, and target criteria are pre-loaded. Click below to launch the hunt across {locations}."
STAGE_BANNER_SUBTITLE="Agentic AI • GenAI • FastMCP • {locations} ($0 Spend)"
STAGE_BANNER_BUTTON_TEXT="Start Live Startup & Job Hunt"
STAGE_BADGE_TEXT=""

# Candidate Profile
ACTIVE_PROFILE_ID=default
USER_FULL_NAME="Your Full Name"
USER_HEADLINE="Agentic AI & GenAI Systems Engineer | LangGraph • FastMCP • RAG"
USER_EMAIL="your.email@example.com"
USER_PHONE="+91 0000000000"
USER_LOCATION="Remote / India"
USER_EDUCATION="B.Tech Computer Science (AIML)"
USER_LINKEDIN_URL="https://www.linkedin.com/in/your-profile"
USER_GITHUB_URL="https://github.com/your-username"
USER_PORTFOLIO_URL=""
USER_EXPERIENCE_YEARS=1
USER_SKILLS="Python,LangGraph,Agentic AI,Model Context Protocol (MCP),FastMCP,Generative AI,RAG,FastAPI,Docker,PyTorch"
USER_SUMMARY="AI/ML Engineer specializing in Agentic AI, Generative AI, and production-ready AI systems with hands-on experience building multi-agent workflows and RAG pipelines."

# Agent Directives (Custom prompts given to the autonomous matching and outreach agent)
AGENT_DIRECTIVES="Target fast-moving AI startups and product companies with 50-300 employees offering 7-10 LPA. Strictly avoid mass IT service firms. For small startups, identify Founders, CEOs, and CTOs directly since they hire via LinkedIn/Email. Highlight real-world project workflows and tool calling in all outreach."

# Job Search Preferences
TARGET_ROLES="Agentic AI Engineer,Generative AI Engineer,Junior AI Engineer,Associate AIML Engineer,AI Systems Engineer"
TARGET_LOCATIONS="Gurugram,Pune,Surat,Dehradun,Remote"
EXPERIENCE_LEVEL="0-3 years"
TARGET_SALARY_MIN=700000
TARGET_SALARY_MAX=1000000
TARGET_SALARY_DISPLAY="₹7-10 LPA"
COMPANY_SIZE="50-300 employees"
REMOTE_ONLY=false
MAX_RESULTS_PER_SOURCE=15
EXCLUDED_COMPANIES="TCS,Infosys,Wipro,Cognizant,Accenture,Capgemini,Tech Mahindra,HCLTech,LTIMindtree,Mphasis,Hexaware,IBM,DXC Technology,Birlasoft,Persistent Systems"

# Scraper Source Toggles (true / false)
SOURCE_LINKEDIN=true
SOURCE_NAUKRI=true
SOURCE_WELLFOUND=true
SOURCE_INDEED=true
SOURCE_GLASSDOOR=true

# Notification Settings (iPhone lock screen via free ntfy.sh, Email, or Telegram)
NTFY_ENABLED=true
NTFY_TOPIC=getmehired_alerts
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_RECIPIENT=
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Autonomous Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=30
AUTO_EVAL_FIT=true
AUTO_FIND_CONTACTS=true
AUTO_DRAFT_OUTREACH=true
AUTO_NOTIFY_THRESHOLD=75
